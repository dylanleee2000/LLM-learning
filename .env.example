# LLM API Keys
# 复制此文件为 .env 并填入你的真实 API Key

# OpenAI API (https://platform.openai.com/api-keys)
OPENAI_API_KEY=your_openai_api_key_here

# 阿里云通义千问 (https://dashscope.console.aliyun.com/apiKey)
DASHSCOPE_API_KEY=your_dashscope_api_key_here

# volcano火山大模型 (https://console.volcengine.com/ark/region:ark+cn-beijing/apiKey?apikey=%7B%7D)
VOLCANO_API_KEY="your_volcano_api_key_here"

# 小米 MiMo 大模型 (https://mimo.ai/)
MIMO_API_KEY=your_mimo_api_key_here
# MIMO_BASE_URL=https://api.xiaomimimo.com/v1

# LangSmith 追踪 (可选, https://smith.langchain.com/)
LANGCHAIN_API_KEY=your_langchain_api_key_here
LANGCHAIN_TRACING_V2=true
LANGCHAIN_PROJECT=llm-learning

# Ollama 本地模型 (无需 API Key，确保本地已安装 Ollama)
# OLLAMA_BASE_URL=http://localhost:11434
